# ─── Required ────────────────────────────────────────────────────────────────

# Browserless.io — cloud browser for scraping (free tier available)
# Get your token at https://browserless.io
BROWSERLESS_TOKEN=your_browserless_token_here

# ─── AI (pick ONE — Groq is recommended, it's free) ──────────────────────────

# Groq — free, fast, Llama 3.3 70B
# Sign up at https://console.groq.com
GROQ_API_KEY=

# Google Gemini — fallback if Groq key is empty
# Get key at https://aistudio.google.com
GOOGLE_API_KEY=

# OpenAI — last resort fallback
# OPENAI_API_KEY=

# ─── App settings ─────────────────────────────────────────────────────────────

ENVIRONMENT=development
LANGCHAIN_TRACING_V2=false
